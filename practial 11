#include <iostream>
#include <vector>
#include <iomanip>

using namespace std;

const int INF = 1e9; // Represents infinity (no direct edge)

// Function to print the path from source to destination
void printPath(int u, int v, const vector<vector<int>>& next) {
    if (next[u][v] == -1) {
        cout << "No path exists";
        return;
    }
    cout << u;
    while (u != v) {
        u = next[u][v];
        cout << " -> " << u;
    }
}

void floydWarshall(const vector<vector<int>>& graph) {
    int V = graph.size();
    
    // dist[i][j] stores the shortest distance from i to j
    vector<vector<int>> dist = graph;
    
    // next[i][j] stores the next vertex in the shortest path from i to j
    vector<vector<int>> next(V, vector<int>(V, -1));

    // Initialize next matrix
    for (int i = 0; i < V; ++i) {
        for (int j = 0; j < V; ++j) {
            if (graph[i][j] != INF && i != j) {
                next[i][j] = j;
            }
        }
    }

    // Main Floyd-Warshall Dynamic Programming loop
    for (int k = 0; k < V; ++k) {
        for (int i = 0; i < V; ++i) {
            for (int j = 0; j < V; ++j) {
                // Prevent integer overflow when adding INF
                if (dist[i][k] != INF && dist[k][j] != INF) {
                    if (dist[i][k] + dist[k][j] < dist[i][j]) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                        next[i][j] = next[i][k]; // Update path tracer
                    }
                }
            }
        }
    }

    // Check for negative-weight cycles
    for (int i = 0; i < V; ++i) {
        if (dist[i][i] < 0) {
            cout << "Warning: Negative-weight cycle detected in the graph!\n";
            return;
        }
    }

    // Display the shortest distance matrix
    cout << "Shortest Distance Matrix:\n";
    for (int i = 0; i < V; ++i) {
        for (int j = 0; j < V; ++j) {
            if (dist[i][j] == INF) {
                cout << setw(5) << "INF";
            } else {
                cout << setw(5) << dist[i][j];
            }
        }
        cout << "\n";
    }

    // Example Path Retrieval: Path from vertex 0 to vertex 2
    cout << "\nShortest path from 0 to 2: ";
    printPath(0, 2, next);
    cout << "\nDistance: " << dist[0][2] << "\n";
}

int main() {
    // Adjacency matrix representation of a graph with 4 vertices (0 to 3)
    vector<vector<int>> graph = {
        {0,   5,   INF, 10},
        {INF, 0,   3,   INF},
        {INF, INF, 0,   1},
        {INF, INF, INF, 0}
    };

    floydWarshall(graph);

    return 0;
}
